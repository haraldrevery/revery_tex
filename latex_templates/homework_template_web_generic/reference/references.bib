% ============================================================
%  references.bib  — sample bibliography database
%
%  HOW TO CITE IN YOUR .tex FILES
%  ─────────────────────────────────────────────────────────
%  \cite{key}          →  Author (Year)          [authoryear style]
%  \citep{key}         →  (Author, Year)         [parenthetical]
%  \citet{key}         →  Author (Year)          [textual / narrative]
%  \citeauthor{key}    →  Author
%  \citeyear{key}      →  Year
%  \cites{key1}{key2}  →  Author1 (Year1); Author2 (Year2)
%
%  EXAMPLES (paste anywhere in your chapter files):
%    As shown by \citet{knuth1984}, …
%    The approach is well established \citep{lamport1994, goossens1993}.
%    \citeauthor{einstein1905} (\citeyear{einstein1905}) proved that …
%
%  COMPILE ORDER
%    xelatex main  →  bibtex main  →  xelatex main  →  xelatex main
%
%  NOTE: bibtex, not biber.  No WebAssembly build of biber exists (it is
%  Perl), so a document that needs it cannot be compiled in the browser.
%  Classic BibTeX is compiled into the engine and Revery TeX runs it for
%  you as soon as it sees \bibliography{}.  With biblatex, write
%  \usepackage[backend=bibtex, style=numeric, sorting=none]{biblatex}.
%
%  The \cite forms listed above are the biblatex/natbib ones.  With plain
%  BibTeX and a .bst style such as unsrt, only \cite{key} is available.
% ============================================================


