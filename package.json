{
  "name": "revery-tex",
  "version": "0.1.0",
  "description": "A local-first LaTeX editor",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "start:tauri": "tauri dev   --config tauri/tauri.conf.json",
    "build:tauri": "tauri build --config tauri/tauri.conf.json",
    "serve": "node test/serve.js",
    "serve:static": "REVERY_TEX_STATIC=1 PORT=8778 node test/serve.js",
    "gate": "node test/run_phase0.js",
    "test:web": "node test/run_web_backends.js",
    "build:texmf": "node build_tools/build_slim_texmf.js",
    "test": "node --test \"test/**/*.test.js\"",
    "start:electron": "env -u ELECTRON_RUN_AS_NODE electron .",
    "test:electron": "node test/run_electron.js",
    "build:electron": "env -u ELECTRON_RUN_AS_NODE electron-builder --linux deb rpm",
    "version:check": "node build_tools/sync_version.js --check",
    "version:set": "node build_tools/sync_version.js",
    "verify:installers": "node test/verify_installers.js",
    "test:tauri": "node test/run_tauri.js",
    "test:tauri:engine": "bash test/run_tauri_engine.sh",
    "test:ui": "node test/run_ui.js"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "main": "electron/main.js",
  "author": {
    "name": "Harald Revery",
    "email": "harald.thirslund@gmail.com"
  },
  "homepage": "https://haraldrevery.com",
  "desktopName": "revery-tex.desktop"
}
