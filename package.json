{
  "name": "revery-tex",
  "version": "0.1.0",
  "description": "A local-first LaTeX editor",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "start:tauri": "tauri dev   --config tauri/tauri.conf.json",
    "build:tauri": "tauri build --config tauri/tauri.conf.json",
    "serve": "node test/serve.js",
    "serve:static": "REVERY_TEX_STATIC=1 PORT=8778 node test/serve.js",
    "gate": "node test/run_phase0.js",
    "test:web": "node test/run_web_backends.js",
    "build:texmf": "node build_tools/build_slim_texmf.js",
    "test": "node --test \"test/**/*.test.js\"",
    "start:electron": "env -u ELECTRON_RUN_AS_NODE electron .",
    "build:electron": "electron-builder"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "electron": "^33.0.0"
  },
  "main": "electron/main.js"
}
