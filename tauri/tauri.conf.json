{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Revery TeX",
  "version": "0.1.0",
  "identifier": "com.haraldrevery.tex",
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: asset: http://asset.localhost; frame-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'"
    },
    "windows": [
      {
        "label": "main",
        "title": "Revery TeX",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "dragDropEnabled": false
      }
    ]
  },
  "build": {
    "frontendDist": "../www",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../LICENSE": "LICENSE",
      "../LICENSE-APACHE": "LICENSE-APACHE",
      "../LICENSE-ASSETS": "LICENSE-ASSETS",
      "../NOTICE": "NOTICE",
      "../font/FONT-LICENSE.txt": "FONT-LICENSE.txt"
    },
    "publisher": "Harald Revery",
    "homepage": "https://haraldrevery.com",
    "license": "AGPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "category": "Productivity",
    "shortDescription": "Local-first LaTeX editor",
    "longDescription": "Edit, compile and preview LaTeX entirely on your own machine. Bundles TeX Live 2026 compiled to WebAssembly, so there is no server, no account and no network.",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3"]
      }
    }
  }
}
